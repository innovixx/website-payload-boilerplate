{
  "name": "website-payload-boilerplate",
  "version": "0.0.0",
  "description": "A boilerplate for a Payload server",
  "repository": "git@github.com:innovixx/website-payload-boilerplate.git",
  "author": "Innovixx <support@innovixx.co.uk>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 9000",
    "cleanDev": "rm -rf ./storage && cross-env PAYLOAD_DROP_DATABASE=true PAYLOAD_SEED_DATABASE=true next dev -p 9000",
    "build": "next build",
    "serve": "cross-env NODE_ENV=production next start -p 9000",
    "payload": "payload",
    "codegen": "cross-env TS_NODE_PROJECT=tsconfig.codegen.json graphql-codegen --config codegen.ts",
    "generate:types": "payload generate:types",
    "generate:graphql": "payload generate:graphQLSchema",
    "lint": "eslint ./src/**/*.{js,jsx,ts,tsx}",
    "lint-staged": "lint-staged --verbose",
    "prepare": "if [ -d node_modules/husky ]; then husky; fi"
  },
  "dependencies": {
    "@azure/storage-blob": "12.26.0",
    "@innovixx/payload-drawer-fields": "^0.0.8",
    "@innovixx/payload-icon-picker-field": "^1.0.3",
    "@payloadcms/db-mongodb": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/plugin-seo": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/storage-azure": "3.83.0",
    "@payloadcms/ui": "3.83.0",
    "body-parser": "^2.2.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "next": "15.5.9",
    "payload": "3.83.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.0",
    "@graphql-codegen/client-preset": "^5.3.0",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@innovixx/eslint-config": "^3.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "^2.4.1",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint",
      "bash -c tsc"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}