{
  "name": "website-payload-boilerplate",
  "version": "0.0.0",
  "description": "A boilerplate for a Payload server",
  "repository": "git@github.com:innovixx/website-payload-boilerplate.git",
  "author": "Innovixx <support@innovixx.co.uk>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 9000",
    "cleanDev": "rm -rf ./storage && cross-env PAYLOAD_DROP_DATABASE=true PAYLOAD_SEED_DATABASE=true next dev -p 9000",
    "build": "next build",
    "serve": "cross-env NODE_ENV=production next start -p 9000",
    "payload": "payload",
    "codegen": "cross-env TS_NODE_PROJECT=tsconfig.codegen.json graphql-codegen --config codegen.ts",
    "generate:types": "payload generate:types",
    "generate:graphql": "payload generate:graphQLSchema",
    "lint": "eslint ./src/**/*.{js,jsx,ts,tsx,graphql}",
    "lint-staged": "lint-staged --verbose",
    "prepare": "if [ -d node_modules/husky ]; then husky; fi"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@innovixx/payload-drawer-fields": "^0.0.8",
    "@innovixx/payload-icon-picker-field": "^1.0.3",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-azure": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "body-parser": "^2.3.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "graphql": "^16.0.2",
    "graphql-request": "^7.4.0",
    "next": "15.5.9",
    "payload": "3.90.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@innovixx/eslint-config": "^3.0.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "copyfiles": "^2.4.1",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx}": [
      "eslint",
      "bash -c tsc"
    ]
  }
}